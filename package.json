{
  "name": "aku-player",
  "productName": "aku-player",
  "version": "0.2.0",
  "description": "A local music player for Windows",
  "author": "4KIR4fo",
  "license": "MIT",
  "homepage": "https://github.com/4KIR4fo/AKU-PLAYER#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/4KIR4fo/AKU-PLAYER.git"
  },
  "bugs": {
    "url": "https://github.com/4KIR4fo/AKU-PLAYER/issues"
  },
  "keywords": [
    "music-player",
    "electron",
    "windows",
    "audio",
    "mp3",
    "flac"
  ],
  "main": "main.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --win portable",
    "dist": "electron-builder --win portable",
    "postinstall": "node node_modules/electron/install.js"
  },
  "build": {
    "appId": "com.akuplayer.app",
    "productName": "aku-player",
    "artifactName": "AKU.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "style.css",
      "renderer.js",
      "mini.html",
      "mini.css",
      "mini.js",
      "mini-preload.js",
      "package.json",
      "build/icon.png"
    ],
    "win": {
      "icon": "build/icon.png",
      "executableName": "AKU",
      "target": [
        "portable"
      ]
    }
  },
  "devDependencies": {
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "music-metadata": "^12.2.1"
  }
}
